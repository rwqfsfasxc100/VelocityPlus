[mod_information]

name="Velocity Plus"
id="hev.VelocityPlus"
description="VELOCITYPLUS_DESCRIPTION"
brief="VELOCITYPLUS_BRIEF"
author="__hev"
credits=PoolStringArray( "Za\'krin - Mod Main design, original implementation of updateTL", "harrygiel - original implementation of the MaximumSpeed mod which this mod fixes and uses for the remove speed limit module", "CyberShadow - original implementation for the DiveClock, ShowReliability, and ARMFocus modules", "Alfik0 - original implementation of the identification limit increase modules", "   --- Supporters ---   ", "GAZI - supporter (ko-fi)", "Bagger dude - supporter (ko-fi)", "WT - supporter (ko-fi)" )

[version]

version_major=1
version_minor=6
version_bugfix=1

[tags]

TAG_ALLOW_ACHIEVEMENTS={
"type": "bool",
"value": false
}
TAG_OVERHAUL={
"type": "bool",
"value": true
}
TAG_QOL={
"type": "bool",
"value": true
}
TAG_ADD_TRANSIT_TIPS={
"type": "array",
"value": [ "VP_TRANSIT_TIP_1", "VP_TRANSIT_TIP_2", "VP_TRANSIT_TIP_3" ]
}

[links]

HEVLIB_GITHUB={
"URL": "https://github.com/rwqfsfasxc100/VelocityPlus"
}
HEVLIB_DISCORD={
"URL": "https://discord.com/channels/426287934870781952/1383342280878067762"
}
HEVLIB_DONATIONS={
"URL": "https://ko-fi.com/00hev"
}
HEVLIB_BUGREPORTS={
"URL": "https://forms.gle/vUoarawnYjy3hXJi9"
}

