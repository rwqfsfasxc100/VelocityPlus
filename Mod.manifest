conflicting_mod_ids=["hev.NoHudEmp","res://AcheetaDeez.ModMain.gd","res://AchieveDeez/ModMain.gd","res://MIsForMPU/ModMain.gd","res://DTT/ModMain.gd","res://ShowReliability/ModMain.gd","res://ARMFocus/ModMain.gd","res://rmIdLim/ModMain.gd","res://MaximumSpeed/ModMain.gd","hev.HudHider","hev.RingActivity","hev.NoMoreCrew","hev.RemoveLIMITS","hev.OCPVoyagerFix","hev.NoSimHex","res://DiveClock/ModMain.gd"]
